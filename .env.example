# Copy this file to .env.local for local development.
# Never commit .env.local or any secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Public Google OAuth web client ID used for One Tap/FedCM. This is not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# AI-assisted grading is disabled by default. The demo workspace does not require an API key.
AI_GRADING_ENABLED=false
AI_GRADING_PROVIDER=disabled
# Add provider secrets only in local/Vercel environment variables after approval; never commit them.
# OPENAI_API_KEY=
